# Nova AI by VirgoYT — self-hosted environment template
# Copy the contents into a private .env file. Never commit real secrets.

# Required: MySQL/TiDB database for workspaces, chats, vault data, models, and GitHub connections.
DATABASE_URL=mysql://nova_user:CHANGE_ME@127.0.0.1:3306/nova_ai

# Required: generate a unique high-entropy value, for example: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

NODE_ENV=production
PORT=3000

# Your browser-accessible URL. Use http://127.0.0.1:3000 locally or your deployed HTTPS URL.
PUBLIC_APP_URL=http://127.0.0.1:3000

# Local uploads for a single server with persistent disk. Mount this directory when using Docker.
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./data/uploads

# Optional Google sign-in. Register ${PUBLIC_APP_URL}/api/auth/google/callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub repository connection. Register ${PUBLIC_APP_URL}/api/nova-github with GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
